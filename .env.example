APP_ENV=development
APP_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Roubaix LLM defaults (bridged to Cognee on startup via cognee_setup.py) ---
# OpenRouter for chat/graph LLM work; OpenAI direct for embeddings is recommended.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_MODEL=openai/gpt-4o-mini
DEFAULT_LLM_ENDPOINT=https://openrouter.ai/api/v1
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536

# Cognee Cloud HTTP API only — leave empty for local SDK + Postgres/pgGraph.
COGNEE_API_KEY=
COGNEE_BASE_URL=

ROUBAIX_COGNEE_SETUP=true
ROUBAIX_DEFAULT_DATASET=default
ROUBAIX_MAX_EVIDENCE_ITEMS=12
ROUBAIX_MAX_RETRIES=2
ROUBAIX_ENABLE_TEMPORAL=true

# Cache settings (HyperSpace-inspired content store)
ROUBAIX_CACHE_MAX_SIZE=4096
ROUBAIX_CACHE_DEFAULT_TTL_S=3600
ROUBAIX_CACHE_FRESHNESS_TTL_S=120

# --- Cognee local stack (read directly by Cognee; see docs.cognee.ai/setup-configuration) ---
# Roubaix fills LLM_* / EMBEDDING_* from the keys above when these are unset.

# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_ENDPOINT=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_TEMPERATURE=0.0

# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=

# DB_PROVIDER=postgres
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=cognee
# DB_USERNAME=cognee
# DB_PASSWORD=cognee

# GRAPH_DATABASE_PROVIDER=pggraph
# GRAPH_DATABASE_HOST=localhost
# GRAPH_DATABASE_PORT=5433
# GRAPH_DATABASE_NAME=cognee
# GRAPH_DATABASE_USERNAME=cognee
# GRAPH_DATABASE_PASSWORD=cognee
# PGGRAPH_BUILD_MODE=manual
# ENABLE_BACKEND_ACCESS_CONTROL=false

# pgGraph adapter: pip install cognee-community-graph-adapter-pggraph asyncpg
# https://github.com/topoteretes/cognee-community/tree/main/packages/graph/pggraph

# Temporal settings
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=roubaix-router

# Demo video only (scripts/build_demo_video.py --tts elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
